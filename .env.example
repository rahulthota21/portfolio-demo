# ─────────────────────────────────────────────────────────────
# Supabase — Settings → API
# Leave blank and the site runs from built-in seed data.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://fnrtcprauxqudxjfdgnc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OPTIONAL. Not required — writes run through your own logged-in session and
# are enforced by row-level security. Only set this if you want a bypass key
# for scripted maintenance. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# The ONLY email allowed to sign in at /jackal.
ADMIN_EMAIL=rahulthota21@gmail.com

# ── STEALTH MODE for the private console ─────────────────────────────────
# Set a long random string here (openssl rand -hex 24) and the console
# becomes invisible: every /jackal page returns a real 404 unless the
# request carries the key. Your private login bookmark is then:
#
#   https://rahulthota.dev/jackal/login?k=<this value>
#
# Bookmark it. Without the key nobody - humans or bots - can even tell the
# console exists. Leave blank to keep the old visible-login behaviour.
JACKAL_GATE_KEY=

# Formspree endpoint for the contact + design enquiry forms.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/meajqgar

# Public site URL (metadata, OG tags, sitemap).
NEXT_PUBLIC_SITE_URL=https://rahulthota.dev
